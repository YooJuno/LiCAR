<UserControl x:Class="licar_wpf.Views.PharmacistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:licar_wpf.Views"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280"
             Background="#F0F2F5">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="5" Padding="15">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="약 운반 요청 목록" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <DataGrid ItemsSource="{Binding DeliveryList}" SelectedItem="{Binding SelectedDelivery, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="요청 번호" Binding="{Binding DeliveryId}" Width="*"/>
                        <DataGridTextColumn Header="현재 상태" Binding="{Binding Status}" Width="*"/>
                        <DataGridTextColumn Header="로봇 번호" Binding="{Binding RobotId}" Width="*"/>
                        <DataGridTextColumn Header="간호사" Binding="{Binding NurseName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" CornerRadius="5" Padding="15">
                <TextBlock Text="처방전 목록" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
            </Border>
            <ListView Grid.Row="1" ItemsSource="{Binding PrescriptionList}" SelectedItem="{Binding SelectedPrescription, Mode=TwoWay}" Margin="0,10,0,0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="처방전 번호" DisplayMemberBinding="{Binding PrescriptionId}" Width="120"/>
                        <GridViewColumn Header="환자 이름" DisplayMemberBinding="{Binding PatientName}" Width="150"/>
                        <GridViewColumn Header="처방 날짜" DisplayMemberBinding="{Binding Date}" Width="150"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedPrescription.Drugs}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,200,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="약 이름" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="제형" Binding="{Binding Form}" Width="*"/>
                    <DataGridTextColumn Header="용량" Binding="{Binding Dosage}" Width="*"/>
                    <DataGridTextColumn Header="단위" Binding="{Binding Unit}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>