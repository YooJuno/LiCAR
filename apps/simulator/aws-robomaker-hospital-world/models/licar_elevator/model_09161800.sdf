<?xml version="1.0"?>
  <sdf version="1.6">
    <model name="licar_elevator">
      <static>false</static>

      <!-- 고정 베이스 링크 -->
      <link name="base_link">
        <pose>0 0 0 0 0 0</pose>
        <gravity>false</gravity>
        <kinematic>true</kinematic>  <!-- 완전 고정 -->

        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>

        <!-- 작은 빨간 마커 (고정점 표시) -->
        <visual name="base_marker">
          <geometry><sphere><radius>0.03</radius></sphere></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>

        <collision name="base_col">
          <geometry><sphere><radius>0.01</radius></sphere></geometry>
        </collision>
      </link>

      <!-- 엘리베이터 칸 (중력 무시 + 동적 제어) -->
      <link name="elevator_car">
        <pose>0 0 0 0 0 0</pose>    <!-- 초기 높이 0.2m -->

        <inertial>
          <mass>100.0</mass>
          <inertia>
            <ixx>50</ixx><iyy>50</iyy><izz>50</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>

        <!-- 엘리베이터 칸 모양 (박스) -->
        <visual name="car_visual">
          <geometry><mesh>
            <uri>model://licar_elevator/meshes/aws_robomaker_hospital_elevator_01_car_visual.dae</uri>
          </mesh></geometry>
          <material>
            <ambient>0.8 0.8 0.9 1</ambient>
            <diffuse>0.9 0.9 1 1</diffuse>
          </material>
        </visual>

        <!-- 충돌 박스 -->
        <collision name="car_collision">
          <geometry><mesh>
            <uri>model://licar_elevator/meshes/aws_robomaker_hospital_elevator_01_car_collision.dae</uri>
          </mesh></geometry>
        </collision>
      </link>

      <!-- 수직 이동 조인트 -->
      <joint name="elevator_joint" type="prismatic">
        <parent>base_link</parent>
        <child>elevator_car</child>
        <axis>
          <xyz>0 0 1</xyz>  
          <limit>
            <lower>0</lower>  
            <upper>8.0</upper>
            <effort>10000</effort>    <!-- 충분한 힘 -->
            <velocity>2.0</velocity> <!-- 최대 속도 2m/s -->
          </limit>

          <!-- 안정성을 위한 댐핑/마찰 -->
          <dynamics damping="100.0" friction="10.0"/>
        </axis>
        
      </joint>

      <!-- 베이스를 월드에 고정 -->
      <joint name="world_anchor" type="fixed">
        <parent>world</parent>
        <child>base_link</child>
      </joint>

      <!-- Joint 상태 퍼블리셔 -->
      <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
        <update_rate>50</update_rate>
        <joint_name>elevator_joint</joint_name>
      </plugin>

      <!-- 포지션 제어 플러그인 -->
      <plugin name="joint_position_controller" filename="libgazebo_ros_joint_pose_trajectory.so">
        <update_rate>100</update_rate>
        <joint_name>elevator_joint</joint_name>
      </plugin>
    </model>
  </sdf>