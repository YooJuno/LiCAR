<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="aws_robomaker_hospital_elevator_01_car">
    <static>true</static>

    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <gravity>0</gravity>
      <kinematic>0</kinematic>
      <collision name="base_collision">
      <pose>0 0 0.15 0 0 0</pose>
      <geometry>
        <box>
          <size>1.8 1.8 0.3</size>   
        </box>
      </geometry>

 
      <surface>
        <friction>
          <ode>
            <mu>0.8</mu>            
            <mu2>0.8</mu2>
          </ode>
        </friction>
        <contact>
          <ode>
            <kp>1000000</kp>         
            <kd>1000</kd>          
            <max_vel>0.01</max_vel> 
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
      </surface>
    </collision>
    </link>

    <link name="elevator_car">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>2000.0</mass>
        <pose>0 0 0.15 0 0 0</pose>
        <inertia>
          <ixx>333.33</ixx>   
          <iyy>333.33</iyy>
          <izz>666.67</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://licar_elevator/meshes/aws_robomaker_hospital_elevator_01_car_visual.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://licar_elevator/meshes/aws_robomaker_hospital_elevator_01_car_collision.dae</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <joint name="elevator_joint" type="prismatic">
      <parent>link</parent>
      <child>elevator_car</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>5</upper>
          <effort>10000</effort>
          <velocity>2.0</velocity>
        </limit>

      <dynamics>
        <damping>500.0</damping>   
        <friction>50.0</friction>   
        <spring_stiffness>1000</spring_stiffness> 
      </dynamics>


      <use_parent_model_frame>true</use_parent_model_frame>
      </axis>


      <physics>
      <ode>
        <implicit_spring_damper>true</implicit_spring_damper>
        <cfm_damping>true</cfm_damping>
      </ode>
    </physics>
    </joint>

    <!-- ROS2 플러그인 -->
    <plugin name="elevator_joint_state" filename="libgazebo_ros_joint_state_publisher.so">       
      <ros>
        <namespace>/elevator</namespace>
      </ros>
      <update_rate>50</update_rate>
      <joint_name>elevator_joint</joint_name>
    </plugin>

    <plugin name="elevator_controller" filename="libgazebo_ros_joint_pose_trajectory.so">        
      <ros>
        <namespace>/elevator</namespace>
      </ros>
      <update_rate>50</update_rate>
    </plugin>


   
    <pose>0 0 0.2 0 0 0</pose>


    <allow_auto_disable>false</allow_auto_disable>
    

    <physics>
      <collision_detector>ode</collision_detector>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
  </model>
</sdf>