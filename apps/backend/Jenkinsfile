pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'master', credentialsId: 'git-credentials', url: 'https://lab.ssafy.com/s13-mobility-smarthome-sub1/S13P21C206.git'
            }
        }

        stage('Build') {
            steps {
                script {
                    // sh 'docker build -t your-username/spring-app:latest ./backend'
                    sh 'cd licar && chmod +x gradlew && ./gradlew clean build -x test'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    sh 'docker build -t spring:latest ./licar'
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    sh 'docker compose down'
                    sh 'docker compose up -d'
                }
            }
        }
    }
}